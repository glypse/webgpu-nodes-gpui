     // time on platforms like mac which spawns thousands of nullabilty complieance warnings
@@ -1082,7 +1084,7 @@ fn link_to_libraries(statik: bool, target_os: &str) {
     ) {
         println!("cargo:rustc-link-arg=-Wl,--no-as-needed");
     }
